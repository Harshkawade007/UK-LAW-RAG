# Copy this file to .env and fill in your own token:
#
#     cp .env.example .env
#
# Only the LLM calls need it - rewriting queries, grading results, choosing a
# pipeline, and writing answers. Building the index and running the free
# evaluation pipelines (dense, hybrid, rerank) work without any token at all.
#
# Get one at https://deepinfra.com
DEEPINFRA_TOKEN=your_token_here

# Optional. Leave both unset and everything uses the local qdrant_data/
# folder, exactly as before - no account needed. Set both to point
# ingestion/index.py and every search pipeline at a remote Qdrant instead (a
# Qdrant Cloud cluster, in practice - free tier at https://cloud.qdrant.io
# comfortably covers this corpus). Re-run `python ingestion/index.py` after
# setting these to actually populate the remote collection; setting them alone
# does not move data that is already sitting in the local folder.
QDRANT_URL=
QDRANT_API_KEY=
